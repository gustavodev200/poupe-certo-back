# Supabase (projeto "poupe-certo")
SUPABASE_URL=https://mcuipdmthhpfbjneuspw.supabase.co

# Postgres do mesmo projeto, via Supavisor pooler. Host exato: Dashboard > Connect
# (formato aws-N-us-east-1.pooler.supabase.com). Usuario do pooler = <role>.<project_ref>.
#
# DATABASE_URL: transaction pooler (6543), role de runtime SEM privilegio (app_runtime).
DATABASE_URL="postgresql://app_runtime.mcuipdmthhpfbjneuspw:<APP_RUNTIME_PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: session pooler (5432), role postgres — so para `prisma migrate deploy`.
DIRECT_URL="postgresql://postgres.mcuipdmthhpfbjneuspw:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres"

# Origem(ns) do frontend, separadas por virgula (CORS allowlist — nunca "*")
FRONTEND_URL=http://localhost:3000

PORT=3333

# Documentacao Swagger/OpenAPI em GET /docs. Desligar em producao publica se
# a API nao deve expor o proprio shape de rotas (default: ligado).
SWAGGER_ENABLED=true
